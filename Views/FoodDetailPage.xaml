<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriLens.Views.FoodDetailPage"
             Title="Food Detail"
             BackgroundColor="{AppThemeBinding Light=#F0F4F8, Dark=#0F0F1A}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Hero Header -->
            <Grid x:Name="HeroGrid"
                  HeightRequest="260">

                <!-- Background food image -->
                <Image x:Name="HeroImage"
                       Aspect="AspectFill"
                       IsVisible="False"/>

                <!-- Fallback icon when no image -->
                <VerticalStackLayout VerticalOptions="Center"
                         HorizontalOptions="Center">

                    <Frame x:Name="IconFrame"
                           CornerRadius="50"
                           WidthRequest="90"
                           HeightRequest="90"
                           Padding="0"
                           BorderColor="Transparent">

                        <Label x:Name="IconLabel"
                               FontSize="44"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>

                    </Frame>

                </VerticalStackLayout>

            </Grid>

            <!-- Food Info Card -->
            <Frame Margin="16,-25,16,0"
                   CornerRadius="28"
                   Padding="22"
                   HasShadow="True"
                   BorderColor="Transparent">

                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0"
                         EndPoint="1,1">

                        <GradientStop Color="{AppThemeBinding Light=#E8F5E9, Dark=#1F2A24}"
                      Offset="0.0"/>

                        <GradientStop Color="{AppThemeBinding Light=#DCEFDF, Dark=#28362F}"
                      Offset="1.0"/>

                    </LinearGradientBrush>
                </Frame.Background>

                <VerticalStackLayout Spacing="12">

                    <!-- Food Name -->
                    <Label x:Name="FoodNameLabel"
                           FontSize="30"
                           FontAttributes="Bold"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>

                    <!-- Category Badge -->
                    <Frame Padding="12,5"
                           CornerRadius="12"
                           BorderColor="Transparent"
                           HorizontalOptions="Start">

                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,0">

                                <GradientStop Color="{AppThemeBinding Light=#E8F5E9, Dark=#163020}"
                                  Offset="0"/>

                                <GradientStop Color="{AppThemeBinding Light=#C8E6C9, Dark=#23452E}"
                                  Offset="1"/>

                            </LinearGradientBrush>
                        </Frame.Background>

                        <HorizontalStackLayout Spacing="6">

                            <Label Text="🏷"
                       FontSize="12"
                       VerticalOptions="Center"/>

                            <Label x:Name="CategoryLabel"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}"
                       VerticalOptions="Center"/>

                        </HorizontalStackLayout>

                    </Frame>

                </VerticalStackLayout>

            </Frame>
            
            <!-- Calorie Highlight Card -->
            <Frame Margin="16,14,16,0"
                   CornerRadius="20"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="Transparent"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}">
                <Grid ColumnDefinitions="*,Auto,*">
                    <VerticalStackLayout Grid.Column="0"
                                         HorizontalOptions="Center"
                                         Spacing="2">
                        <Label Text="🔥 Calories"
                               FontSize="13" TextColor="Gray"
                               HorizontalOptions="Center"/>
                        <Label x:Name="CaloriesValueLabel"
                               FontSize="36" FontAttributes="Bold"
                               TextColor="#FF5722"
                               HorizontalOptions="Center"/>
                        <Label Text="kcal / 100g"
                               FontSize="12" TextColor="Gray"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <BoxView Grid.Column="1"
                             WidthRequest="1" BackgroundColor="#EEEEEE"
                             VerticalOptions="Fill" Margin="8,4"/>
                    <VerticalStackLayout Grid.Column="2"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="2">
                        <Label Text="⚡ Energy"
                               FontSize="13" TextColor="Gray"
                               HorizontalOptions="Center"/>
                        <Label x:Name="KjLabel"
                               FontSize="36" FontAttributes="Bold"
                               TextColor="#FF9800"
                               HorizontalOptions="Center"/>
                        <Label Text="kJ / 100g"
                               FontSize="12" TextColor="Gray"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- Macros Grid -->
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="10"
                  Margin="16,14,16,0">
                <Frame Grid.Column="0"
                       CornerRadius="18" Padding="14" HasShadow="True"
                       BorderColor="Transparent"
                       BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D2137}">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="💪" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="ProteinValueLabel"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="#2196F3" HorizontalOptions="Center"/>
                        <Label Text="g" FontSize="11" TextColor="#2196F3"
                               HorizontalOptions="Center"/>
                        <Label Text="Protein" FontSize="11" TextColor="Gray"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1"
                       CornerRadius="18" Padding="14" HasShadow="True"
                       BorderColor="Transparent"
                       BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#2A1500}">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="🥑" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="FatValueLabel"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="#FF9800" HorizontalOptions="Center"/>
                        <Label Text="g" FontSize="11" TextColor="#FF9800"
                               HorizontalOptions="Center"/>
                        <Label Text="Fat" FontSize="11" TextColor="Gray"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="2"
                       CornerRadius="18" Padding="14" HasShadow="True"
                       BorderColor="Transparent"
                       BackgroundColor="{AppThemeBinding Light=#FCE4EC, Dark=#2A0014}">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="🍬" FontSize="24" HorizontalOptions="Center"/>
                        <Label x:Name="SugarValueLabel"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="#E91E63" HorizontalOptions="Center"/>
                        <Label Text="g" FontSize="11" TextColor="#E91E63"
                               HorizontalOptions="Center"/>
                        <Label Text="Sugar" FontSize="11" TextColor="Gray"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Ingredients Card -->
            <Frame x:Name="IngredientsCard"
                   Margin="16,14,16,0"
                   CornerRadius="20"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="Transparent"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="🧂" FontSize="18"/>
                        <Label Text="Ingredients"
                               FontSize="15" FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <FlexLayout x:Name="IngredientsLayout"
                                Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignItems="Start"/>
                    <Label Text="⚠️ Highlighted ingredients match your allergen settings"
                           FontSize="11"
                           TextColor="Gray"
                           x:Name="AllergenHintLabel"
                           IsVisible="False"/>
                </VerticalStackLayout>
            </Frame>

            <!-- TTS Card -->
            <Frame Margin="16,14,16,0"
                   CornerRadius="20"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="Transparent"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Read Aloud"
                           FontSize="15" FontAttributes="Bold" TextColor="Gray"/>
                    <Label x:Name="TtsPreviewLabel"
                           FontSize="13" TextColor="Gray"
                           LineBreakMode="WordWrap"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                x:Name="SpeakButton"
                                Text="🔊 Read Aloud"
                                BackgroundColor="#FF9800" TextColor="White"
                                CornerRadius="14" HeightRequest="48"
                                FontAttributes="Bold"
                                Clicked="OnSpeakClicked"/>
                        <Button Grid.Column="1"
                                x:Name="StopButton"
                                Text="⏹ Stop"
                                BackgroundColor="#9E9E9E" TextColor="White"
                                CornerRadius="14" HeightRequest="48"
                                FontAttributes="Bold"
                                IsEnabled="False"
                                Clicked="OnStopClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Close Button -->
            <Button Text="Close"
                    Margin="16,14,16,28"
                    BackgroundColor="#EEEEEE" TextColor="#555555"
                    CornerRadius="16" HeightRequest="52"
                    FontSize="15" FontAttributes="Bold"
                    Clicked="OnCloseClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
