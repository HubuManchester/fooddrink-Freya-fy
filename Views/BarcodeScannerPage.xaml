<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    x:Class="NutriLens.Views.BarcodeScannerPage"
    Title="Scan Barcode"
    BackgroundColor="Black">

	<Grid RowDefinitions="*,Auto">

		<!-- Camera barcode reader -->
		<zxing:CameraBarcodeReaderView
            x:Name="BarcodeReader"
            Grid.Row="0"
            BarcodesDetected="OnBarcodesDetected" />

		<!-- Overlay -->
		<Grid Grid.Row="0" InputTransparent="True">

			<Frame
                Margin="60,160,60,160"
                BorderColor="White"
                BackgroundColor="Transparent"
                CornerRadius="16"
                HasShadow="False" />

			<Label
                Text="Align barcode within the frame"
                TextColor="White"
                FontSize="14"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,180" />

		</Grid>

		<!-- Cancel -->
		<Button
            Grid.Row="1"
            Text="Cancel"
            BackgroundColor="#333333"
            TextColor="White"
            CornerRadius="0"
            HeightRequest="56"
            FontSize="16"
            Clicked="OnCancelClicked" />

		<Button x:Name="TorchButton"
            Grid.Column="1"
            Text="🔦 Torch"
            BackgroundColor="#555555"
            TextColor="White"
            CornerRadius="0"
            HeightRequest="56"
            WidthRequest="110"
            FontSize="14"
            SemanticProperties.Hint="Toggle flashlight for scanning in low light"
            Clicked="OnTorchClicked"/>

	</Grid>

</ContentPage>