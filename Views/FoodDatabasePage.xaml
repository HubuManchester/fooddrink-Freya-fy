<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriLens.Views.FoodDatabasePage"
             Title=""
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0"
                             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                             Padding="16,16,16,12"
                             Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="Food Database"
                       FontSize="22"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
                <Button Grid.Column="1"
                        Text="+ Add Food"
                        SemanticProperties.Hint="Add a new food item to the database"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="20"
                        HeightRequest="36"
                        FontSize="{DynamicResource GlobalFontSize}"
                        FontAttributes="Bold"
                        Padding="12,0"
                        Clicked="OnAddFoodClicked"/>
            </Grid>

            <!-- Search Bar -->
            <Frame BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}"
                   CornerRadius="20"
                   Padding="12,0"
                   HeightRequest="44"
                   BorderColor="Transparent">
                <Grid ColumnDefinitions="Auto,*">
                    <SearchBar Grid.Column="1"
                               x:Name="SearchBar"
                               SemanticProperties.Hint="Type to search foods by name or category"
                               Placeholder="Search food name..."
                               TextChanged="OnSearchTextChanged"
                               FontSize="{DynamicResource GlobalFontSize}"
                               BackgroundColor="Transparent"
                               HeightRequest="44"/>
                </Grid>
            </Frame>

            <!-- Stats Row -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Frame Grid.Column="0"
                       BackgroundColor="#E8F5E9"
                       CornerRadius="10"
                       Padding="10,8"
                       BorderColor="Transparent">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Total"
                               FontSize="{DynamicResource GlobalFontSize}"
                               TextColor="Gray"
                               HorizontalOptions="Center"/>
                        <Label x:Name="TotalFoodsLabel"
                               Text="0"
                               FontSize="{DynamicResource GlobalFontSize}"
                               FontAttributes="Bold"
                               TextColor="#4CAF50"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1"
                       BackgroundColor="#E3F2FD"
                       CornerRadius="10"
                       Padding="10,8"
                       BorderColor="Transparent">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Avg kcal"
                               FontSize="{DynamicResource GlobalFontSize}"
                               TextColor="Gray"
                               HorizontalOptions="Center"/>
                        <Label x:Name="AvgCaloriesLabel"
                               Text="0"
                               FontSize="{DynamicResource GlobalFontSize}"
                               FontAttributes="Bold"
                               TextColor="#2196F3"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="2"
                       BackgroundColor="#FFF3E0"
                       CornerRadius="10"
                       Padding="10,8"
                       BorderColor="Transparent">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Categories"
                               FontSize="{DynamicResource GlobalFontSize}"
                               TextColor="Gray"
                               HorizontalOptions="Center"/>
                        <Label x:Name="CategoriesLabel"
                               Text="0"
                               FontSize="{DynamicResource GlobalFontSize}"
                               FontAttributes="Bold"
                               TextColor="#FF9800"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

        </VerticalStackLayout>

        <!-- Body: Left Category Nav + Right Food List -->
        <Grid Grid.Row="1" ColumnDefinitions="80,*">

            <!-- Left Category Navigation -->
            <ScrollView Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}">
                <VerticalStackLayout x:Name="CategoryNav"
                                     Spacing="0"
                                     Padding="0,8"/>
            </ScrollView>

            <!-- Right Food List -->
            <RefreshView Grid.Column="1"
                         x:Name="RefreshView"
                         Refreshing="OnRefreshing">
                <CollectionView x:Name="FoodList"
                                SelectionMode="None"
                                IsGrouped="True"
                                Margin="0">

                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="12,14,12,6">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding HeaderIcon}"
                                           FontSize="20"
                                           VerticalOptions="Center"/>
                                    <Label Text="{Binding Key}"
                                           FontSize="{DynamicResource GlobalFontSize}"
                                           FontAttributes="Bold"
                                           TextColor="#4CAF50"
                                           VerticalOptions="Center"/>
                                    <Label Text="{Binding Count, StringFormat='({0})'}"
                                           FontSize="{DynamicResource GlobalFontSize}"
                                           TextColor="Gray"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="10"
                                             Margin="0,60">
                            <Label Text="🍽️"
                                   FontSize="48"
                                   HorizontalOptions="Center"/>
                            <Label Text="No foods found"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                            <Label Text="Tap + Add Food to get started"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   TextColor="Gray"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView Margin="8,2">
                                <SwipeView.LeftItems>
                                    <SwipeItems>
                                        <SwipeItemView Invoked="OnEditFoodSwiped">
                                            <Frame BackgroundColor="#2196F3"
                                                   WidthRequest="72"
                                                   Padding="0"
                                                   BorderColor="Transparent">
                                                <VerticalStackLayout
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Spacing="3">

                                                    <Label Text="✏️"
                                                           FontSize="18"
                                                           HorizontalOptions="Center"/>

                                                    <Label Text="Edit"
                                                           FontSize="{DynamicResource GlobalFontSize}"
                                                           FontAttributes="Bold"
                                                           TextColor="White"
                                                           HorizontalOptions="Center"/>

                                                </VerticalStackLayout>
                                            </Frame>
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.LeftItems>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItemView Invoked="OnDeleteFoodSwiped">
                                            <Frame BackgroundColor="#FF5252"
                                                   WidthRequest="72"
                                                   Padding="0"
                                                   BorderColor="Transparent">
                                                <VerticalStackLayout
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Spacing="3">
                                                    <Label Text="🗑️"
                                                           FontSize="18"
                                                           HorizontalOptions="Center"/>
                                                    <Label Text="Delete"
                                                           FontSize="{DynamicResource GlobalFontSize}"
                                                           FontAttributes="Bold"
                                                           TextColor="White"
                                                           HorizontalOptions="Center"/>
                                                </VerticalStackLayout>
                                            </Frame>
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Frame CornerRadius="12"
                                       Padding="10,10"
                                       HasShadow="False"
                                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                                       BorderColor="Transparent">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="OnFoodTapped"
                                            CommandParameter="{Binding .}"/>
                                    </Frame.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="10">

                                        <!-- Icon -->
                                        <Frame Grid.Column="0"
                                               BackgroundColor="{Binding CategoryColor}"
                                               CornerRadius="10"
                                               WidthRequest="44"
                                               HeightRequest="44"
                                               Padding="0"
                                               VerticalOptions="Center"
                                               BorderColor="Transparent">
                                            <Label Text="{Binding CategoryIcon}"
                                                   FontSize="22"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Frame>

                                        <!-- Info -->
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="3"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   FontSize="{DynamicResource GlobalFontSize}"/>
                                            <Label Text="{Binding Calories, StringFormat='{0:F0} kcal / 100g'}"
                                                   TextColor="#4CAF50"
                                                   FontSize="{DynamicResource GlobalFontSize}"
                                                   FontAttributes="Bold"/>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Protein, StringFormat='P {0:F1}g'}"
                                                       TextColor="#2196F3"
                                                       FontSize="{DynamicResource GlobalFontSize}"/>
                                                <Label Text="·"
                                                       TextColor="Gray"
                                                       FontSize="{DynamicResource GlobalFontSize}"/>
                                                <Label Text="{Binding Fat, StringFormat='F {0:F1}g'}"
                                                       TextColor="#FF9800"
                                                       FontSize="{DynamicResource GlobalFontSize}"/>
                                                <Label Text="·"
                                                       TextColor="Gray"
                                                       FontSize="{DynamicResource GlobalFontSize}"/>
                                                <Label Text="{Binding Sugar, StringFormat='S {0:F1}g'}"
                                                       TextColor="#E91E63"
                                                       FontSize="{DynamicResource GlobalFontSize}"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

        </Grid>

    </Grid>

</ContentPage>