<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriLens.Views.NearbyPage"
             Title="Nearby">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Nearby Healthy Places 📍"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Label Text="Find healthy restaurants near you"
                   FontSize="{DynamicResource GlobalFontSize}"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>

            <!-- Location Card -->
            <Frame BackgroundColor="#E3F2FD"
                   CornerRadius="15"
                   Padding="15">
                <VerticalStackLayout Spacing="8">
                    <Label Text="📍 Your Location"
                           FontSize="{DynamicResource GlobalFontSize}"
                           FontAttributes="Bold"/>
                    <Label x:Name="LocationLabel"
                           Text="Location not detected yet"
                           FontSize="{DynamicResource GlobalFontSize}"
                           TextColor="Gray"/>
                    <Label x:Name="CoordinatesLabel"
                           Text=""
                           FontSize="{DynamicResource GlobalFontSize}"
                           TextColor="Gray"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Find Button -->
            <Button Text="📍 Find Nearby Healthy Restaurants"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="10"
                    FontSize="{DynamicResource GlobalFontSize}"
                    Clicked="OnFindNearbyClicked"/>

            <!-- Loading -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#4CAF50"
                               HorizontalOptions="Center"/>

            <!-- Empty State -->
            <VerticalStackLayout x:Name="EmptyState" Spacing="10">
                <Label Text="🗺️"
                       FontSize="48"
                       HorizontalOptions="Center"/>
                <Label Text="Tap the button to find nearby places"
                       FontSize="{DynamicResource GlobalFontSize}"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Results List -->
            <CollectionView x:Name="PlacesList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" CornerRadius="10" Padding="15">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnPlaceTapped"
                                    CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0"
                                       Text="🍃"
                                       FontSize="24"
                                       VerticalOptions="Center"
                                       Margin="0,0,10,0"/>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="{DynamicResource GlobalFontSize}"/>
                                    <Label Text="{Binding Address}"
                                           TextColor="Gray"
                                           FontSize="{DynamicResource GlobalFontSize}"/>
                                    <Label Text="{Binding Distance}"
                                           TextColor="#4CAF50"
                                           FontSize="{DynamicResource GlobalFontSize}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>