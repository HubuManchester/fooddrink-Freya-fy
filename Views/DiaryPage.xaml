<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriLens.Views.DiaryPage"
             Title="Diary">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Food Diary 📅"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"/>

        <!-- Today's Summary -->
        <Frame BackgroundColor="#E8F5E9"
               CornerRadius="15"
               Padding="15">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0"
                                     HorizontalOptions="Center">
                    <Label Text="Calories"
                           FontSize="{DynamicResource GlobalFontSize}"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                    <Label x:Name="TotalCaloriesLabel"
                           Text="0"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#4CAF50"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1"
                                     HorizontalOptions="Center">
                    <Label Text="Protein"
                           FontSize="{DynamicResource GlobalFontSize}"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                    <Label x:Name="TotalProteinLabel"
                           Text="0g"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#2196F3"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2"
                                     HorizontalOptions="Center">
                    <Label Text="Fat"
                           FontSize="{DynamicResource GlobalFontSize}"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                    <Label x:Name="TotalFatLabel"
                           Text="0g"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#FF9800"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Empty State -->
        <VerticalStackLayout x:Name="EmptyState"
                             Spacing="10"
                             IsVisible="True">
            <Label Text="🍽️"
                   FontSize="48"
                   HorizontalOptions="Center"/>
            <Label Text="No entries yet"
                   FontSize="{DynamicResource GlobalFontSize}"
                   HorizontalOptions="Center"
                   TextColor="Gray"/>
            <Label Text="Start scanning food to track your nutrition"
                   FontSize="{DynamicResource GlobalFontSize}"
                   HorizontalOptions="Center"
                   TextColor="Gray"/>
        </VerticalStackLayout>

        <!-- Diary List -->
        <CollectionView x:Name="DiaryList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="Red"
                                           Clicked="OnDeleteSwipe"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Frame Margin="0,5"
                               CornerRadius="10"
                               Padding="15">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="3">
                                    <Label Text="{Binding FoodName}"
                                           FontAttributes="Bold"
                                           FontSize="{DynamicResource GlobalFontSize}"/>
                                    <Label Text="{Binding MealType}"
                                           TextColor="Gray"
                                           FontSize="{DynamicResource GlobalFontSize}"/>
                                    <Label Text="{Binding Date, StringFormat='{0:HH:mm}'}"
                                           TextColor="Gray"
                                           FontSize="{DynamicResource GlobalFontSize}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding Calories, StringFormat='{0:F0} kcal'}"
                                       TextColor="#4CAF50"
                                       FontAttributes="Bold"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>