<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriLens.Views.DiaryPage"
             Title="Diary"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header Card -->
        <Grid Grid.Row="0" Padding="16">

            <Frame CornerRadius="20"
                   Padding="0"
                   HasShadow="True"
                   BorderColor="Transparent">

                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                        <GradientStop Offset="0.0">
                            <GradientStop.Color>
                                <AppThemeBinding Light="#E3F2FD" Dark="#121826"/>
                            </GradientStop.Color>
                        </GradientStop>

                        <GradientStop Offset="0.5">
                            <GradientStop.Color>
                                <AppThemeBinding Light="#BBDEFB" Dark="#1B263B"/>
                            </GradientStop.Color>
                        </GradientStop>

                        <GradientStop Offset="1.0">
                            <GradientStop.Color>
                                <AppThemeBinding Light="#90CAF9" Dark="#243B55"/>
                            </GradientStop.Color>
                        </GradientStop>

                    </LinearGradientBrush>
                </Frame.Background>

                <VerticalStackLayout VerticalOptions="Center"
                                     Padding="20"
                                     Spacing="14">

                    <!-- Title -->
                    <Label Text="Food Diary 📅"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#0D47A1, Dark=#E3F2FD}"/>

                    <!-- Stats Row -->
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="10">

                        <!-- Calories -->
                        <Frame Grid.Column="0"
                               CornerRadius="14"
                               Padding="10,8"
                               BorderColor="Transparent">

                            <Frame.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}" Offset="0.0"/>
                                    <GradientStop Color="{AppThemeBinding Light=#E3F2FD, Dark=#2A2A3A}" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Frame.Background>

                            <VerticalStackLayout Spacing="2">
                                <Label Text="Calories"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#607D8B, Dark=#B0BEC5}"
                                       HorizontalOptions="Center"/>
                                <Label x:Name="TotalCaloriesLabel"
                                       Text="0"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#E65100, Dark=#FFB74D}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Protein -->
                        <Frame Grid.Column="1"
                               CornerRadius="14"
                               Padding="10,8"
                               BorderColor="Transparent">

                            <Frame.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}" Offset="0.0"/>
                                    <GradientStop Color="{AppThemeBinding Light=#E8F5E9, Dark=#263238}" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Frame.Background>

                            <VerticalStackLayout Spacing="2">
                                <Label Text="Protein"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#607D8B, Dark=#B0BEC5}"
                                       HorizontalOptions="Center"/>
                                <Label x:Name="TotalProteinLabel"
                                       Text="0g"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Fat -->
                        <Frame Grid.Column="2"
                               CornerRadius="14"
                               Padding="10,8"
                               BorderColor="Transparent">

                            <Frame.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}" Offset="0.0"/>
                                    <GradientStop Color="{AppThemeBinding Light=#FFF3E0, Dark=#2A2A3A}" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Frame.Background>

                            <VerticalStackLayout Spacing="2">
                                <Label Text="Fat"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#607D8B, Dark=#B0BEC5}"
                                       HorizontalOptions="Center"/>
                                <Label x:Name="TotalFatLabel"
                                       Text="0g"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#EF6C00, Dark=#FFCC80}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                    </Grid>

                </VerticalStackLayout>

            </Frame>

        </Grid>
        
        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                    <!-- Scan Food -->
                    <Button Grid.Column="0"
                            Text="📷 Scan Food"
                            SemanticProperties.Hint="Open food scanner panel"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="52"
                            FontSize="15"
                            FontAttributes="Bold"
                            Clicked="OnScanFoodClicked">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{AppThemeBinding Light=#77C784, Dark=#2E7D32}" Offset="0.0"/>
                                <GradientStop Color="{AppThemeBinding Light=#66B76A, Dark=#1B5E20}" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>

                    </Button>

                    <Button Grid.Column="1"
                            Text="+ Add Manually"
                            SemanticProperties.Hint="Manually enter food nutrition information"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="52"
                            FontSize="15"
                            FontAttributes="Bold"
                            Clicked="OnAddEntryClicked">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{AppThemeBinding Light=#F0B74D, Dark=#EF6C00}" Offset="0.0"/>
                                <GradientStop Color="{AppThemeBinding Light=#FFA786, Dark=#E65100}" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>

                    </Button>

                </Grid>

                <!-- Scanner Panel (hidden by default) -->
                <Frame x:Name="ScannerPanel"
                       IsVisible="False"
                       CornerRadius="20"
                       Padding="16"
                       BorderColor="Transparent"
                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}">
                    <VerticalStackLayout Spacing="12">

                        <!-- Tab Switcher -->
                        <Frame BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2C2C2C}"
                               CornerRadius="14"
                               Padding="4"
                               BorderColor="Transparent">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                <Button x:Name="PhotoTabBtn"
                                        Grid.Column="0"
                                        Text="📷 Photo"
                                        SemanticProperties.Hint="Open food scanner"
                                        BackgroundColor="#4CAF50"
                                        TextColor="White"
                                        CornerRadius="10"
                                        HeightRequest="40"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Clicked="OnPhotoTabClicked"/>
                                <Button x:Name="BarcodeTabBtn"
                                        Grid.Column="1"
                                        Text="🔍 Barcode"
                                        SemanticProperties.Hint="Open barcode scanner"
                                        BackgroundColor="Transparent"
                                        TextColor="Gray"
                                        CornerRadius="10"
                                        HeightRequest="40"
                                        FontSize="13"
                                        Clicked="OnBarcodeTabClicked"/>
                            </Grid>
                        </Frame>

                        <!-- Photo Panel -->
                        <VerticalStackLayout x:Name="PhotoPanel" Spacing="10">
                            <Frame x:Name="PhotoPreviewFrame"
                                   IsVisible="False"
                                   CornerRadius="14"
                                   Padding="0"
                                   IsClippedToBounds="True"
                                   BorderColor="Transparent">
                                <Image x:Name="FoodImage"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Fill"
                                       MaximumHeightRequest="500">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFoodImageTapped"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </Frame>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                                <!-- Camera -->
                                <Button Grid.Column="0"
                                        Text="📸 Camera"
                                        SemanticProperties.Hint="Open food scanner camera"
                                        TextColor="White"
                                        CornerRadius="12"
                                        HeightRequest="46"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Clicked="OnTakePhotoClicked">

                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{AppThemeBinding Light=#546E7A, Dark=#263238}" Offset="0.0"/>
                                            <GradientStop Color="{AppThemeBinding Light=#455A64, Dark=#1C262B}" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Button.Background>

                                </Button>

                                <!-- Gallery -->
                                <Button Grid.Column="1"
                                        Text="🎞 Gallery"
                                        SemanticProperties.Hint="Open gallery"
                                        TextColor="White"
                                        CornerRadius="12"
                                        HeightRequest="46"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Clicked="OnPickPhotoClicked">

                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{AppThemeBinding Light=#7986CB, Dark=#3949AB}" Offset="0.0"/>
                                            <GradientStop Color="{AppThemeBinding Light=#5C6BC0, Dark=#1A237E}" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Button.Background>

                                </Button>

                            </Grid>
                        </VerticalStackLayout>

                        <!-- Barcode Panel -->
                        <VerticalStackLayout x:Name="BarcodePanel"
                     IsVisible="False"
                     Spacing="12">

                            <!-- Scan Barcode Button -->
                            <Button Text="📷 Scan Barcode"
                                    TextColor="White"
                                    CornerRadius="12"
                                    HeightRequest="46"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Clicked="OnScanBarcodeClicked">

                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{AppThemeBinding Light=#64B5F6, Dark=#1565C0}" Offset="0.0"/>
                                        <GradientStop Color="{AppThemeBinding Light=#1E88E5, Dark=#0D47A1}" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Button.Background>

                            </Button>

                            <Frame CornerRadius="12"
                                   Padding="6"
                                   BorderColor="Transparent">

                                <Frame.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{AppThemeBinding Light=#FAFAFA, Dark=#1E1E1E}" Offset="0.0"/>
                                        <GradientStop Color="{AppThemeBinding Light=#F0F0F0, Dark=#262626}" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Frame.Background>

                                <Entry x:Name="ManualBarcodeEntry"
                                       Placeholder="Enter barcode manually"
                                       Keyboard="Numeric"
                                       FontSize="14"
                                       BackgroundColor="Transparent"
                                       Margin="10,0"
                                       TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                                       PlaceholderColor="{AppThemeBinding Light=#9E9E9E, Dark=#757575}"/>

                            </Frame>

                            <!-- Search Button -->
                            <Button Text="🔎 Search"
                                    TextColor="White"
                                    CornerRadius="12"
                                    HeightRequest="44"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    Clicked="OnManualBarcodeSearchClicked">

                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{AppThemeBinding Light=#FFB74D, Dark=#EF6C00}" Offset="0.0"/>
                                        <GradientStop Color="{AppThemeBinding Light=#FFA726, Dark=#E65100}" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Button.Background>

                            </Button>

                        </VerticalStackLayout>

                        <!-- Loading -->
                        <ActivityIndicator x:Name="ScanLoadingIndicator"
                                           IsRunning="False"
                                           IsVisible="False"
                                           Color="#4CAF50"
                                           HorizontalOptions="Center"/>

                        <!-- Scan Result -->
                        <Frame x:Name="ScanResultFrame"
                               IsVisible="False"
                               CornerRadius="14"
                               Padding="16"
                               BackgroundColor="{AppThemeBinding Light=#F9FFF9, Dark=#1A2A1A}"
                               BorderColor="#4CAF50">
                            <VerticalStackLayout Spacing="10">
                                <Label x:Name="ScanFoodNameLabel"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"/>

                                <Frame x:Name="AllergenWarningFrame"
                                       IsVisible="False"
                                       BackgroundColor="#FFEBEE"
                                       CornerRadius="12"
                                       Padding="12"
                                       BorderColor="#FFCDD2">           
                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label Text="⚠️"
                                               FontSize="16"
                                               VerticalOptions="Center"/>
                                        <Label x:Name="AllergenWarningLabel"
                                               TextColor="#D32F2F"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               VerticalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap"/>
                                    </HorizontalStackLayout>
                                </Frame>
                                
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                                        <Label Text="🔥" FontSize="16" HorizontalOptions="Center"/>
                                        <Label x:Name="ScanCaloriesLabel"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="#4CAF50" HorizontalOptions="Center"/>
                                        <Label Text="kcal" FontSize="10" TextColor="Gray"
                                               HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                                        <Label Text="💪" FontSize="16" HorizontalOptions="Center"/>
                                        <Label x:Name="ScanProteinLabel"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="#2196F3" HorizontalOptions="Center"/>
                                        <Label Text="protein" FontSize="10" TextColor="Gray"
                                               HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                                        <Label Text="🥑" FontSize="16" HorizontalOptions="Center"/>
                                        <Label x:Name="ScanFatLabel"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="#FF9800" HorizontalOptions="Center"/>
                                        <Label Text="fat" FontSize="10" TextColor="Gray"
                                               HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                                        <Label Text="🍬" FontSize="16" HorizontalOptions="Center"/>
                                        <Label x:Name="ScanSugarLabel"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="#E91E63" HorizontalOptions="Center"/>
                                        <Label Text="sugar" FontSize="10" TextColor="Gray"
                                               HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Grid>

                                <Label Text="Save to meal:"
                                       FontSize="12"
                                       TextColor="Gray"
                                       HorizontalOptions="Center"/>

                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                    <Button Grid.Column="0"
                                            Text="🌅"
                                            BackgroundColor="#FFF9C4"
                                            TextColor="#F57F17"
                                            CornerRadius="10"
                                            HeightRequest="52"
                                            FontSize="20"
                                            Clicked="OnScanSaveBreakfastClicked"/>
                                    <Button Grid.Column="1"
                                            Text="☀️"
                                            BackgroundColor="#FFE0B2"
                                            TextColor="#E65100"
                                            CornerRadius="10"
                                            HeightRequest="52"
                                            FontSize="20"
                                            Clicked="OnScanSaveLunchClicked"/>
                                    <Button Grid.Column="2"
                                            Text="🌙"
                                            BackgroundColor="#E8EAF6"
                                            TextColor="#3949AB"
                                            CornerRadius="10"
                                            HeightRequest="52"
                                            FontSize="20"
                                            Clicked="OnScanSaveDinnerClicked"/>
                                    <Button Grid.Column="3"
                                            Text="🥨"
                                            BackgroundColor="#FCE4EC"
                                            TextColor="#C62828"
                                            CornerRadius="10"
                                            HeightRequest="52"
                                            FontSize="20"
                                            Clicked="OnScanSaveSnackClicked"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*,*">
                                    <Label Grid.Column="0" Text="Breakfast" FontSize="10"
                                           TextColor="Gray" HorizontalOptions="Center"/>
                                    <Label Grid.Column="1" Text="Lunch" FontSize="10"
                                           TextColor="Gray" HorizontalOptions="Center"/>
                                    <Label Grid.Column="2" Text="Dinner" FontSize="10"
                                           TextColor="Gray" HorizontalOptions="Center"/>
                                    <Label Grid.Column="3" Text="Snack" FontSize="10"
                                           TextColor="Gray" HorizontalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>

                    </VerticalStackLayout>
                </Frame>

                <!-- Empty State -->
                <VerticalStackLayout x:Name="EmptyState"
                                     Spacing="10"
                                     Padding="0,40"
                                     IsVisible="True">
                    <Label Text="🍽️"
                           FontSize="56"
                           HorizontalOptions="Center"/>
                    <Label Text="No entries yet"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label Text="Tap Scan Food or Add Manually to get started"
                           FontSize="{DynamicResource GlobalFontSize}"
                           HorizontalOptions="Center"
                           TextColor="Gray"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- Diary List -->
                <CollectionView x:Name="DiaryList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">

                                        <SwipeItemView Invoked="OnDeleteSwipe"
                                                       CommandParameter="{Binding .}">

                                            <Frame BackgroundColor="#FF5252"
                                                   WidthRequest="72"
                                                   Padding="0"
                                                   BorderColor="Transparent">

                                                <VerticalStackLayout
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Spacing="3">

                                                    <Label Text="🗑️"
                                                           FontSize="18"
                                                           HorizontalOptions="Center"/>

                                                    <Label Text="Delete"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="White"
                                                           HorizontalOptions="Center"/>

                                                </VerticalStackLayout>

                                            </Frame>

                                        </SwipeItemView>

                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Frame Margin="0,4"
                                       CornerRadius="16"
                                       Padding="16"
                                       HasShadow="True"
                                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}"
                                       BorderColor="Transparent">
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="12">
                                        <Frame Grid.Column="0"
                                               BackgroundColor="#E8F5E9"
                                               CornerRadius="12"
                                               WidthRequest="46"
                                               HeightRequest="46"
                                               Padding="0"
                                               VerticalOptions="Center"
                                               BorderColor="Transparent">
                                            <Label Text="🍴"
                                                   FontSize="22"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Frame>
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding FoodName}"
                                                   FontAttributes="Bold"
                                                   FontSize="{DynamicResource GlobalFontSize}"/>
                                            <Label Text="{Binding MealType}"
                                                   TextColor="#4CAF50"
                                                   FontSize="13"
                                                   FontAttributes="Bold"/>
                                            <Label Text="{Binding Date, StringFormat='{0:HH:mm}'}"
                                                   TextColor="Gray"
                                                   FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2"
                                                             HorizontalOptions="End"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Calories, StringFormat='{0:F0}'}"
                                                   TextColor="#4CAF50"
                                                   FontAttributes="Bold"
                                                   FontSize="20"
                                                   HorizontalOptions="End"/>
                                            <Label Text="kcal"
                                                   TextColor="Gray"
                                                   FontSize="11"
                                                   HorizontalOptions="End"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>