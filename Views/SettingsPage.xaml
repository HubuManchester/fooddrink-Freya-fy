<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriLens.Views.SettingsPage"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light=#F0F4F8, Dark=#0F0F1A}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Header -->
            <Grid HeightRequest="130" BackgroundColor="#607D8B">
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Label Text="⚙️ Settings"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Label Text="Customize your experience"
                           FontSize="{DynamicResource GlobalFontSize}"
                           TextColor="#CFD8DC"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="16" Spacing="20">

                <!-- ── Appearance ── -->
                <Label Text="APPEARANCE"
                       FontSize="{DynamicResource GlobalFontSize}"
                       FontAttributes="Bold"
                       TextColor="Gray"
                       Margin="4,0,0,0"
                       CharacterSpacing="1.5"/>

                <Frame CornerRadius="20"
                       Padding="0"
                       HasShadow="True"
                       BorderColor="Transparent"
                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}">
                    <VerticalStackLayout Spacing="0">

                        <!-- Light -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              Padding="18,14">
                            <Frame Grid.Column="0"
                                   BackgroundColor="#FFF9C4"
                                   CornerRadius="12"
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   Padding="0"
                                   BorderColor="Transparent">
                                <Label Text="☀️" FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Light Mode"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       FontAttributes="Bold"/>
                                <Label Text="Always use light theme"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       TextColor="Gray"/>
                            </VerticalStackLayout>
                            <RadioButton Grid.Column="2"
                                         x:Name="LightModeRadio"
                                         GroupName="ThemeGroup"
                                         CheckedChanged="OnThemeChanged"
                                         VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#F0F0F0"
                                 Margin="18,0"/>

                        <!-- Dark -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              Padding="18,14">
                            <Frame Grid.Column="0"
                                   BackgroundColor="#E8EAF6"
                                   CornerRadius="12"
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   Padding="0"
                                   BorderColor="Transparent">
                                <Label Text="🌙" FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Dark Mode"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       FontAttributes="Bold"/>
                                <Label Text="Always use dark theme"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       TextColor="Gray"/>
                            </VerticalStackLayout>
                            <RadioButton Grid.Column="2"
                                         x:Name="DarkModeRadio"
                                         GroupName="ThemeGroup"
                                         CheckedChanged="OnThemeChanged"
                                         VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#F0F0F0"
                                 Margin="18,0"/>

                        <!-- System -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              Padding="18,14">
                            <Frame Grid.Column="0"
                                   BackgroundColor="#E8F5E9"
                                   CornerRadius="12"
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   Padding="0"
                                   BorderColor="Transparent">
                                <Label Text="📱" FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Follow System"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       FontAttributes="Bold"/>
                                <Label Text="Match your device setting"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       TextColor="Gray"/>
                            </VerticalStackLayout>
                            <RadioButton Grid.Column="2"
                                         x:Name="SystemModeRadio"
                                         GroupName="ThemeGroup"
                                         CheckedChanged="OnThemeChanged"
                                         IsChecked="True"
                                         VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- ── Font Size ── -->
                <Label Text="ACCESSIBILITY"
                       FontSize="{DynamicResource GlobalFontSize}"
                       FontAttributes="Bold"
                       TextColor="Gray"
                       Margin="4,0,0,0"
                       CharacterSpacing="1.5"/>

                <Frame CornerRadius="20"
                       Padding="18"
                       HasShadow="True"
                       BorderColor="Transparent"
                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}">
                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Frame Grid.Column="0"
                                   BackgroundColor="#E3F2FD"
                                   CornerRadius="12"
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   Padding="0"
                                   BorderColor="Transparent">
                                <Label Text="🔤" FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Font Size"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       FontAttributes="Bold"/>
                                <Label Text="Adjust text size throughout the app"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       TextColor="Gray"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   x:Name="FontSizeLabel"
                                   Text="16"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#2196F3"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Slider x:Name="FontSizeSlider"
                                SemanticProperties.Description="Font size slider, drag to adjust text size"
                                SemanticProperties.Hint="Current value shown to the right"
                                Minimum="12"
                                Maximum="24"
                                Value="16"
                                ValueChanged="OnFontSizeChanged"
                                MinimumTrackColor="#2196F3"
                                MaximumTrackColor="#BBDEFB"
                                ThumbColor="#2196F3"/>

                        <Grid ColumnDefinitions="*,*">
                            <Label Grid.Column="0"
                                   Text="Small"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   TextColor="Gray"
                                   HorizontalOptions="Start"/>
                            <Label Grid.Column="1"
                                   Text="Large"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   FontAttributes="Bold"
                                   TextColor="Gray"
                                   HorizontalOptions="End"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- ── Nutrition Goals ── -->
                <Label Text="NUTRITION GOALS"
                       FontSize="{DynamicResource GlobalFontSize}"
                       FontAttributes="Bold"
                       TextColor="Gray"
                       Margin="4,0,0,0"
                       CharacterSpacing="1.5"/>

                <Frame CornerRadius="20"
                       Padding="18"
                       HasShadow="True"
                       BorderColor="Transparent"
                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}">
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="🔥" FontSize="16"/>
                                <Label Text="Daily Calorie Target"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Frame Padding="0" CornerRadius="12"
                                   BorderColor="#FBE9E7" HasShadow="False">
                                <Entry x:Name="CalorieTargetEntry"
                                       Text="2000"
                                       Keyboard="Numeric"
                                       Placeholder="e.g. 2000"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       Margin="12,8"/>
                            </Frame>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#F0F0F0"/>

                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="💧" FontSize="16"/>
                                <Label Text="Daily Water Target (ml)"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Frame Padding="0" CornerRadius="12"
                                   BorderColor="#E1F5FE" HasShadow="False">
                                <Entry x:Name="WaterTargetEntry"
                                       Text="2000"
                                       Keyboard="Numeric"
                                       Placeholder="e.g. 2000"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       Margin="12,8"/>
                            </Frame>
                        </VerticalStackLayout>

                        <Button Text="Save Goals"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="14"
                                HeightRequest="50"
                                FontSize="{DynamicResource GlobalFontSize}"
                                FontAttributes="Bold"
                                Clicked="OnSaveGoalsClicked"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- ── Allergen Warnings ── -->
                <Label Text="ALLERGEN WARNINGS"
                       FontSize="{DynamicResource GlobalFontSize}"
                       FontAttributes="Bold"
                       TextColor="Gray"
                       Margin="4,0,0,0"
                       CharacterSpacing="1.5"/>

                <Frame CornerRadius="20"
                       Padding="18"
                       HasShadow="True"
                       BorderColor="Transparent"
                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}">
                    <VerticalStackLayout Spacing="14">

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="⚠️" FontSize="20"/>
                            <VerticalStackLayout>
                                <Label Text="Custom Allergens"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       FontAttributes="Bold"/>
                                <Label Text="Swipe left on an item to remove it"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       TextColor="Gray"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Frame Grid.Column="0"
                                   Padding="0" CornerRadius="12"
                                   BorderColor="#E0E0E0" HasShadow="False">
                                <Entry x:Name="CustomAllergenEntry"
                                       Placeholder="e.g. Peanuts, Gluten, Soy"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       Margin="12,8"/>
                            </Frame>
                            <Button Grid.Column="1"
                                    Text="+ Add"
                                    SemanticProperties.Hint="Add your allergens"
                                    BackgroundColor="#FF9800"
                                    TextColor="White"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    FontSize="{DynamicResource GlobalFontSize}"
                                    FontAttributes="Bold"
                                    Clicked="OnAddCustomAllergenClicked"/>
                        </Grid>

                        <CollectionView x:Name="CustomAllergenList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <SwipeView>
                                        <SwipeView.RightItems>
                                            <SwipeItems Mode="Reveal">
                                                <SwipeItemView
                                                    CommandParameter="{Binding .}"
                                                    Invoked="OnRemoveAllergenClicked">
                                                    <Frame BackgroundColor="#EF5350"
                                                           WidthRequest="80"
                                                           CornerRadius="16"
                                                           Margin="6"
                                                           Padding="0"
                                                           BorderColor="Transparent">
                                                        <Label Text="Remove"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               TextColor="White"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"/>
                                                    </Frame>
                                                </SwipeItemView>
                                            </SwipeItems>
                                        </SwipeView.RightItems>
                                        <Frame Margin="0,3"
                                               CornerRadius="12"
                                               Padding="14,10"
                                               BorderColor="Transparent"
                                               BackgroundColor="#FFF8E1">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Label Grid.Column="0"
                                                       Text="⚠️"
                                                       FontSize="16"
                                                       VerticalOptions="Center"
                                                       Margin="0,0,10,0"/>
                                                <Label Grid.Column="1"
                                                       Text="{Binding .}"
                                                       FontSize="{DynamicResource GlobalFontSize}"
                                                       FontAttributes="Bold"
                                                       TextColor="#E65100"
                                                       VerticalOptions="Center"/>
                                            </Grid>
                                        </Frame>
                                    </SwipeView>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Frame>

                <!-- ── Reminders ── -->
                <Label Text="REMINDERS"
                       FontSize="{DynamicResource GlobalFontSize}"
                       FontAttributes="Bold"
                       TextColor="Gray"
                       Margin="4,0,0,0"
                       CharacterSpacing="1.5"/>

                <Frame CornerRadius="20"
                       Padding="0"
                       HasShadow="True"
                       BorderColor="Transparent"
                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="14"
                          Padding="18,14">
                        <Frame Grid.Column="0"
                               BackgroundColor="#E1F5FE"
                               CornerRadius="12"
                               WidthRequest="40"
                               HeightRequest="40"
                               Padding="0"
                               BorderColor="Transparent">
                            <Label Text="💧" FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Water Reminder"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   FontAttributes="Bold"/>
                            <Label Text="Vibrate every hour if target not met"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   TextColor="Gray"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2"
                                x:Name="WaterReminderSwitch"
                                SemanticProperties.Description="Water reminder toggle"
                                SemanticProperties.Hint="When on, vibrates every hour if water target not met"
                                Toggled="OnWaterReminderToggled"
                                VerticalOptions="Center"
                                OnColor="#4CAF50"/>
                    </Grid>
                </Frame>

                <BoxView HeightRequest="20" BackgroundColor="Transparent"/>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>