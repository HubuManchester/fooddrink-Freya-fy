<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriLens.Views.SettingsPage"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Settings ⚙️"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <!-- Appearance Section -->
            <Label Text="Appearance"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <Frame CornerRadius="15" Padding="15">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Dark Mode"
                           FontSize="{DynamicResource GlobalFontSize}"
                           VerticalOptions="Center"/>
                    <Switch Grid.Column="1"
                            x:Name="DarkModeSwitch"
                            Toggled="OnDarkModeToggled"/>
                </Grid>
            </Frame>

            <!-- Accessibility Section -->
            <Label Text="Accessibility"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <Frame CornerRadius="15" Padding="15">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Text-to-Speech"
                           FontSize="{DynamicResource GlobalFontSize}"
                           VerticalOptions="Center"/>
                    <Switch Grid.Column="1"
                            x:Name="TTSSwitch"
                            Toggled="OnTTSToggled"/>
                </Grid>
            </Frame>

            <Frame CornerRadius="15" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Font Size"
                               FontSize="{DynamicResource GlobalFontSize}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               x:Name="FontSizeLabel"
                               Text="16"
                               FontSize="{DynamicResource GlobalFontSize}"
                               TextColor="#4CAF50"
                               VerticalOptions="Center"/>
                    </Grid>
                    <Slider x:Name="FontSizeSlider"
                            Minimum="12"
                            Maximum="24"
                            Value="16"
                            ValueChanged="OnFontSizeChanged"/>
                    <Label Text="Small                    Large"
                           FontSize="13"
                           TextColor="Gray"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Nutrition Goals Section -->
            <Label Text="Nutrition Goals"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <Frame CornerRadius="15" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Daily Calorie Target (kcal)"
                           FontSize="{DynamicResource GlobalFontSize}"/>
                    <Entry x:Name="CalorieTargetEntry"
                           Text="2000"
                           Keyboard="Numeric"
                           Placeholder="Enter calorie target"
                           FontSize="{DynamicResource GlobalFontSize}"/>
                    <Label Text="Daily Water Target (ml)"
                           FontSize="{DynamicResource GlobalFontSize}"/>
                    <Entry x:Name="WaterTargetEntry"
                           Text="2000"
                           Keyboard="Numeric"
                           Placeholder="Enter water target"
                           FontSize="{DynamicResource GlobalFontSize}"/>
                    <Button Text="💾 Save Goals"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="10"
                            Clicked="OnSaveGoalsClicked"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Allergen Warnings Section -->
            <Label Text="Allergen Warnings"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <Frame CornerRadius="15" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Add allergens you want to be warned about"
                           FontSize="{DynamicResource GlobalFontSize}"
                           TextColor="Gray"/>
                    <Label Text="Swipe left on an allergen to delete it"
                           FontSize="12"
                           TextColor="Gray"
                           FontAttributes="Italic"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0"
                               x:Name="CustomAllergenEntry"
                               Placeholder="e.g. Peanuts, Gluten, Soy"
                               FontSize="{DynamicResource GlobalFontSize}"/>
                        <Button Grid.Column="1"
                                Text="+ Add"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="10"
                                Clicked="OnAddCustomAllergenClicked"/>
                    </Grid>

                    <CollectionView x:Name="CustomAllergenList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItemView
                                                CommandParameter="{Binding .}"
                                                Invoked="OnRemoveAllergenClicked">
                                                <Grid Padding="10,6">
                                                    <Frame
                                                        BackgroundColor="#F87171"
                                                        CornerRadius="18"
                                                        HeightRequest="52"
                                                        WidthRequest="120"
                                                        Padding="16,0"
                                                        HasShadow="False"
                                                        BorderColor="#E5E7EB"
                                                        VerticalOptions="Center">
                                                        <HorizontalStackLayout
                                                            Spacing="8"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center">
                                                            <Label
                                                                Text="Delete"
                                                                FontSize="17"
                                                                FontAttributes="Bold"
                                                                TextColor="White"
                                                                VerticalOptions="Center"/>
                                                        </HorizontalStackLayout>
                                                    </Frame>
                                                </Grid>
                                            </SwipeItemView>
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Frame Margin="0,3"
                                           CornerRadius="8"
                                           Padding="12">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Label Grid.Column="0"
                                                   Text="⚠️"
                                                   FontSize="{DynamicResource GlobalFontSize}"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,8,0"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding .}"
                                                   FontSize="{DynamicResource GlobalFontSize}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Frame>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Frame>

            <!-- Reminders Section -->
            <Label Text="Reminders"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <Frame CornerRadius="15" Padding="15">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="💧 Water Reminder"
                               FontSize="{DynamicResource GlobalFontSize}"/>
                        <Label Text="Vibrate every hour if target not met"
                               FontSize="12"
                               TextColor="Gray"/>
                    </VerticalStackLayout>
                    <Switch Grid.Column="1"
                            x:Name="WaterReminderSwitch"
                            Toggled="OnWaterReminderToggled"/>
                </Grid>
            </Frame>

            <!-- About Section -->
            <Label Text="About"
                   FontSize="18"
                   FontAttributes="Bold"/>

            <Frame CornerRadius="15" Padding="15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="NutriLens"
                           FontSize="18"
                           FontAttributes="Bold"/>
                    <Label Text="Version 1.0"
                           FontSize="{DynamicResource GlobalFontSize}"
                           TextColor="Gray"/>
                    <Label Text="Accessibility: Follows WCAG 2.1 Guidelines"
                           FontSize="{DynamicResource GlobalFontSize}"
                           TextColor="Gray"/>
                    <Label Text="• WCAG 1.4.3 - Contrast ratio"
                           FontSize="{DynamicResource GlobalFontSize}"
                           TextColor="Gray"/>
                    <Label Text="• WCAG 1.4.4 - Resize text"
                           FontSize="{DynamicResource GlobalFontSize}"
                           TextColor="Gray"/>
                    <Label Text="• WCAG 1.1.1 - Non-text content (TTS)"
                           FontSize="{DynamicResource GlobalFontSize}"
                           TextColor="Gray"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>