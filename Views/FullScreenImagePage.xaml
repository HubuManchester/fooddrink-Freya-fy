<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriLens.Views.FullScreenImagePage"
             Title=""
             BackgroundColor="Black"
             Shell.NavBarIsVisible="False">

    <Grid>

        <!-- Full screen image with pinch zoom -->
        <Image x:Name="FullImage"
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Fill">
            <Image.GestureRecognizers>
                <!-- Double tap to reset zoom -->
                <TapGestureRecognizer Tapped="OnDoubleTapped"
                                      NumberOfTapsRequired="2"/>
                <!-- Pinch to zoom -->
                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated"/>
            </Image.GestureRecognizers>
        </Image>

        <!-- Close Button -->
        <Frame BackgroundColor="#80000000"
               CornerRadius="20"
               WidthRequest="40"
               HeightRequest="40"
               Padding="0"
               BorderColor="Transparent"
               HorizontalOptions="End"
               VerticalOptions="Start"
               Margin="0,50,16,0">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseClicked"/>
            </Frame.GestureRecognizers>
            <Label Text="✕"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Frame>

        <!-- Hint -->
        <Label x:Name="HintLabel"
               Text="Pinch to zoom · Double tap to reset · Tap ✕ to close"
               FontSize="12"
               TextColor="#80FFFFFF"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,0,0,40"/>

    </Grid>

</ContentPage>
