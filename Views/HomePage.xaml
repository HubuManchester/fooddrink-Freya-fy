<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriLens.Views.HomePage"
             Title="Home">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="15">

			<!-- Header -->
			<Label Text="NutriLens 🥗"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

			<Label Text="Your daily nutrition companion"
                   FontSize="{DynamicResource GlobalFontSize}"
                   HorizontalOptions="Center"
                   TextColor="Gray"/>

			<!-- Health Score Card -->
			<Frame BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"
				   CornerRadius="15"
				   Padding="20">
				<VerticalStackLayout Spacing="8">
					<Label Text="Today's Health Score"
                           FontSize="{DynamicResource GlobalFontSize}"
                           FontAttributes="Bold"/>
					<Label x:Name="HealthScoreLabel"
                           Text="- / 10"
                           FontSize="36"
                           FontAttributes="Bold"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
					<Label x:Name="HealthAdviceLabel"
                           Text="Start scanning food to get your score"
                           FontSize="{DynamicResource GlobalFontSize}"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
				</VerticalStackLayout>
			</Frame>

			<!-- Calories Card -->
			<Frame BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D47A1}"
				   CornerRadius="15"
				   Padding="20">
				<VerticalStackLayout Spacing="8">
					<Grid ColumnDefinitions="*,Auto">
						<Label Grid.Column="0"
                               Text="🔥 Calories"
                               FontSize="{DynamicResource GlobalFontSize}"
                               FontAttributes="Bold"/>
						<Label Grid.Column="1"
                               x:Name="CaloriesLabel"
                               Text="0 / 2000 kcal"
                               FontSize="{DynamicResource GlobalFontSize}"
                               TextColor="Gray"/>
					</Grid>
					<ProgressBar x:Name="CaloriesProgress"
                                 Progress="0"
                                 ProgressColor="#2196F3"/>
				</VerticalStackLayout>
			</Frame>

			<!-- Water Intake Card -->
			<Frame BackgroundColor="{AppThemeBinding Light=#E1F5FE, Dark=#01579B}"
				   CornerRadius="15"
				   Padding="20">
				<VerticalStackLayout Spacing="8">
					<Grid ColumnDefinitions="*,Auto">
						<Label Grid.Column="0"
                               Text="💧 Water Intake"
                               FontSize="{DynamicResource GlobalFontSize}"
                               FontAttributes="Bold"/>
						<Label Grid.Column="1"
                               x:Name="WaterLabel"
                               Text="0 / 2000 ml"
                               FontSize="{DynamicResource GlobalFontSize}"
                               TextColor="Gray"/>
					</Grid>
					<ProgressBar x:Name="WaterProgress"
                                 Progress="0"
                                 ProgressColor="#03A9F4"/>
					<Button Text="+ 250ml"
                            BackgroundColor="#03A9F4"
                            TextColor="White"
                            CornerRadius="10"
                            Clicked="OnAddWaterClicked"/>
				</VerticalStackLayout>
			</Frame>

			<!-- Today's Meals -->
			<Label Text="Today's Meals"
                   FontSize="18"
                   FontAttributes="Bold"/>

			<!-- Breakfast -->
			<Frame CornerRadius="15" Padding="15">
				<VerticalStackLayout Spacing="5">
					<Label Text="🌅 Breakfast"
                           FontSize="{DynamicResource GlobalFontSize}"
                           FontAttributes="Bold"/>
					<Label x:Name="BreakfastLabel"
                           Text="No entries yet"
                           TextColor="Gray"
                           FontSize="{DynamicResource GlobalFontSize}"/>
				</VerticalStackLayout>
			</Frame>

			<!-- Lunch -->
			<Frame CornerRadius="15" Padding="15">
				<VerticalStackLayout Spacing="5">
					<Label Text="☀️ Lunch"
                           FontSize="{DynamicResource GlobalFontSize}"
                           FontAttributes="Bold"/>
					<Label x:Name="LunchLabel"
                           Text="No entries yet"
                           TextColor="Gray"
                           FontSize="{DynamicResource GlobalFontSize}"/>
				</VerticalStackLayout>
			</Frame>

			<!-- Dinner -->
			<Frame CornerRadius="15" Padding="15">
				<VerticalStackLayout Spacing="5">
					<Label Text="🌙 Dinner"
                           FontSize="{DynamicResource GlobalFontSize}"
                           FontAttributes="Bold"/>
					<Label x:Name="DinnerLabel"
                           Text="No entries yet"
                           TextColor="Gray"
                           FontSize="{DynamicResource GlobalFontSize}"/>
				</VerticalStackLayout>
			</Frame>

			<!-- Quick Actions -->
			<Label Text="Quick Actions"
                   FontSize="18"
                   FontAttributes="Bold"/>

			<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
				<Button Grid.Column="0"
                        Text="📷 Scan Food"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="10"
                        Clicked="OnScanClicked"/>
				<Button Grid.Column="1"
                        Text="📅 View Diary"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        CornerRadius="10"
                        Clicked="OnDiaryClicked"/>
			</Grid>

			<!-- Shake Hint -->
			<Frame BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#E65000}"
				   CornerRadius="15"
				   Padding="15">
				<Label Text="🎲 Shake your phone for a random meal suggestion!"
                       FontSize="{DynamicResource GlobalFontSize}"
                       HorizontalOptions="Center"/>
			</Frame>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>