<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriLens.Views.HomePage"
             Title="Home"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

	<ScrollView>
		<VerticalStackLayout Spacing="0">

            <!-- Hero Header -->
            <Frame HeightRequest="200"
                   CornerRadius="25"
                   HasShadow="True"
                   BorderColor="Transparent"
                   Padding="0"
                   Margin="5,12,5,8">

                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#43A047" Offset="0.0"/>
                        <GradientStop Color="#81C784" Offset="0.5"/>
                        <GradientStop Color="#26A69A" Offset="1.0"/>
                    </LinearGradientBrush>
                </Frame.Background>

                <Grid>

                    <BoxView BackgroundColor="Black"
                             Opacity="0.15"/>

                    <VerticalStackLayout VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="8"
                                         Padding="20,0">

                        <Label Text="🌿 NutriLens"
                               FontSize="40"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               CharacterSpacing="1.5"/>

                        <Label Text="Your Daily Nutritional Companion 🥗"
                               FontSize="17"
                               TextColor="#E8F5E9"
                               HorizontalOptions="Center"
                               Opacity="0.95"/>

                        <Label Text="Today, 2 June 2026"
                               FontSize="14"
                               TextColor="#C8E6C9"
                               HorizontalOptions="Center"
                               Opacity="0.85"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- Content -->
			<VerticalStackLayout Padding="16" Spacing="14">

				<!-- Health Score Card -->
				<Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}"
                       SemanticProperties.Description="Health score out of 10"
                       CornerRadius="20"
                       Padding="20"
                       HasShadow="True"
                       BorderColor="Transparent">
					<Grid ColumnDefinitions="*,Auto">
						<VerticalStackLayout Grid.Column="0" Spacing="4">
							<Label Text="Health Score"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   TextColor="Gray"
                                   FontAttributes="Bold"/>
							<Label x:Name="HealthScoreLabel"
                                   Text="- / 10"
                                   FontSize="40"
                                   FontAttributes="Bold"
                                   TextColor="#4CAF50"/>
							<Label x:Name="HealthAdviceLabel"
                                   Text="Start scanning food"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   TextColor="Gray"/>
						</VerticalStackLayout>
						<Frame Grid.Column="1"
                               BackgroundColor="#E8F5E9"
                               CornerRadius="40"
                               WidthRequest="80"
                               HeightRequest="80"
                               Padding="0"
                               VerticalOptions="Center">
							<Label Text="💪"
                                   FontSize="36"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
						</Frame>
					</Grid>
				</Frame>

				<!-- Calories + Water Row -->
				<Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                    <!-- Calories Card -->
                    <Frame Grid.Column="0"
                           CornerRadius="20"
                           Padding="16"
                           HasShadow="True"
                           BorderColor="Transparent">

                        <!-- Theme-aware Background -->
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{AppThemeBinding Light=#FFF3E0, Dark=#1A1412 }" Offset="0.0"/>
                                <GradientStop Color="{AppThemeBinding Light=#FFE0B2, Dark=#2A1C18 }" Offset="0.5"/>
                                <GradientStop Color="{AppThemeBinding Light=#FFCCBC, Dark=#3A241E}" Offset="1.0"/>

                            </LinearGradientBrush>
                        </Frame.Background>

                        <VerticalStackLayout Spacing="8">

                            <!-- Icon -->
                            <Label Text="🔥"
                                   FontSize="24"
                                   HorizontalOptions="Start"/>

                            <!-- Title -->
                            <Label Text="Calories"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   TextColor="{AppThemeBinding Light=#6D6D6D, Dark=#B0BEC5}"/>

                            <!-- Value -->
                            <Label x:Name="CaloriesLabel"
                                   Text="0 kcal"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#E65100, Dark=#FFB74D}"/>

                            <!-- Progress -->
                            <ProgressBar x:Name="CaloriesProgress"
                                         Progress="0"
                                         ProgressColor="{AppThemeBinding Light=#FF9800, Dark=#FFB74D}"
                                         BackgroundColor="{AppThemeBinding Light=#33FF9800, Dark=#33FFFFFF}"
                                         HeightRequest="6"/>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <!-- Water Card -->
                    <Frame Grid.Column="1"
                           CornerRadius="20"
                           Padding="16"
                           HasShadow="True"
                           BorderColor="Transparent">

                        <!-- Theme-aware Gradient -->
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                <GradientStop Color="{AppThemeBinding Light=#E0F7FA, Dark=#0F1C24}" Offset="0.0"/>
                                <GradientStop Color="{AppThemeBinding Light=#B2EBF2, Dark=#152B3A}" Offset="0.5"/>
                                <GradientStop Color="{AppThemeBinding Light=#80DEEA, Dark=#1C3A4A}" Offset="1.0"/>

                            </LinearGradientBrush>
                        </Frame.Background>

                        <VerticalStackLayout Spacing="8">

                            <!-- Icon -->
                            <Label Text="💧"
                                   FontSize="24"
                                   HorizontalOptions="Start"/>

                            <!-- Title -->
                            <Label Text="Water"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   TextColor="{AppThemeBinding Light=#607D8B, Dark=#B0BEC5}"/>

                            <!-- Value -->
                            <Label x:Name="WaterLabel"
                                   Text="0 ml"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0288D1, Dark=#4FC3F7}"/>

                            <!-- Progress -->
                            <ProgressBar x:Name="WaterProgress"
                                         Progress="0"
                                         ProgressColor="{AppThemeBinding Light=#03A9F4, Dark=#4FC3F7}"
                                         BackgroundColor="{AppThemeBinding Light=#3303A9F4, Dark=#33FFFFFF}"
                                         HeightRequest="6"/>

                            <!-- Counter -->
                            <Label x:Name="VibrationCountLabel"
                                   Text="Vibrations: 0"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#0288D1, Dark=#90CAF9}"
                                   HorizontalOptions="End"
                                   SemanticProperties.Description="Number of times water button has been pressed"/>

                            <!-- Button -->
                            <Button Text="+ 250ml"
                                    SemanticProperties.Hint="Add 250 millilitres to your water intake"
                                    TextColor="White"
                                    CornerRadius="10"
                                    HeightRequest="36"
                                    FontSize="{DynamicResource GlobalFontSize}"
                                    Padding="0"
                                    Clicked="OnAddWaterClicked">

                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{AppThemeBinding Light=#4FC3F7, Dark=#102A43}" Offset="0.0"/>
                                        <GradientStop Color="{AppThemeBinding Light=#0288D1, Dark=#2F80ED}" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Button.Background>

                            </Button>
                        </VerticalStackLayout>

                    </Frame>

                </Grid>

				<!-- Quick Actions -->
				<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="📷 Scan Food"
                            SemanticProperties.Hint="Opens the food scanner to photograph or scan barcodes"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="52"
                            FontSize="{DynamicResource GlobalFontSize}"
                            FontAttributes="Bold"
                            Clicked="OnScanClicked">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                <GradientStop Color="{AppThemeBinding Light=#66BB6A, Dark=#1B5E20}" Offset="0.0"/>
                                <GradientStop Color="{AppThemeBinding Light=#43A047, Dark=#2E7D32}" Offset="1.0"/>

                            </LinearGradientBrush>
                        </Button.Background>

                    </Button>
                    <Button Grid.Column="1"
                            Text="📅 My Diary"
                            SemanticProperties.Hint="Opens your food diary for today"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="52"
                            FontSize="{DynamicResource GlobalFontSize}"
                            FontAttributes="Bold"
                            Clicked="OnDiaryClicked">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                <GradientStop Color="{AppThemeBinding Light=#64B5F6, Dark=#1565C0}" Offset="0.0"/>
                                <GradientStop Color="{AppThemeBinding Light=#1E88E5, Dark=#0D47A1}" Offset="1.0"/>

                            </LinearGradientBrush>
                        </Button.Background>

                    </Button>
                </Grid>

				<!-- Today's Meals -->
				<Label Text="Today's Meals"
                       FontSize="18"
                       FontAttributes="Bold"
                       Margin="4,4,0,0"/>

				<Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}"
                       CornerRadius="20"
                       Padding="16"
                       HasShadow="True"
                       BorderColor="Transparent">
					<VerticalStackLayout Spacing="14">

						<!-- Breakfast -->
						<Grid ColumnDefinitions="Auto,*">
							<Frame Grid.Column="0"
                                   BackgroundColor="#FFF9C4"
                                   CornerRadius="12"
                                   WidthRequest="44"
                                   HeightRequest="44"
                                   Padding="0"
                                   VerticalOptions="Center">
								<Label Text="🌅"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
							</Frame>
							<VerticalStackLayout Grid.Column="1"
                                                 Margin="12,0,0,0"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
								<Label Text="Breakfast"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       FontAttributes="Bold"/>
								<Label x:Name="BreakfastLabel"
                                       Text="No entries yet"
                                       TextColor="Gray"
                                       FontSize="{DynamicResource GlobalFontSize}"/>
							</VerticalStackLayout>
						</Grid>

						<BoxView HeightRequest="1"
                                 BackgroundColor="#F0F0F0"/>

						<!-- Lunch -->
						<Grid ColumnDefinitions="Auto,*">
							<Frame Grid.Column="0"
                                   BackgroundColor="#FFE0B2"
                                   CornerRadius="12"
                                   WidthRequest="44"
                                   HeightRequest="44"
                                   Padding="0"
                                   VerticalOptions="Center">
								<Label Text="☀️"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
							</Frame>
							<VerticalStackLayout Grid.Column="1"
                                                 Margin="12,0,0,0"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
								<Label Text="Lunch"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       FontAttributes="Bold"/>
								<Label x:Name="LunchLabel"
                                       Text="No entries yet"
                                       TextColor="Gray"
                                       FontSize="{DynamicResource GlobalFontSize}"/>
							</VerticalStackLayout>
						</Grid>

						<BoxView HeightRequest="1"
                                 BackgroundColor="#F0F0F0"/>

						<!-- Dinner -->
						<Grid ColumnDefinitions="Auto,*">
							<Frame Grid.Column="0"
                                   BackgroundColor="#E8EAF6"
                                   CornerRadius="12"
                                   WidthRequest="44"
                                   HeightRequest="44"
                                   Padding="0"
                                   VerticalOptions="Center">
								<Label Text="🌙"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
							</Frame>
							<VerticalStackLayout Grid.Column="1"
                                                 Margin="12,0,0,0"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
								<Label Text="Dinner"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       FontAttributes="Bold"/>
								<Label x:Name="DinnerLabel"
                                       Text="No entries yet"
                                       TextColor="Gray"
                                       FontSize="{DynamicResource GlobalFontSize}"/>
							</VerticalStackLayout>
						</Grid>

					</VerticalStackLayout>
				</Frame>

                <!-- Shake Hint Card -->
                <Frame CornerRadius="20"
                       Padding="18,14"
                       BorderColor="Transparent"
                       HasShadow="True">

                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                            <!-- 🌿 Light -->
                            <GradientStop Color="{AppThemeBinding Light=#E8F5E9, Dark=#0F1C14}" Offset="0.0"/>
                            <GradientStop Color="{AppThemeBinding Light=#C8E6C9, Dark=#16261C}" Offset="0.5"/>
                            <GradientStop Color="{AppThemeBinding Light=#A5D6A7, Dark=#1E3023}" Offset="1.0"/>

                        </LinearGradientBrush>
                    </Frame.Background>
                    
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">

                        <!-- Icon Container -->
                        <Frame Grid.Column="0"
                               CornerRadius="14"
                               WidthRequest="44"
                               HeightRequest="44"
                               Padding="0"
                               BorderColor="Transparent"
                               VerticalOptions="Center">

                            <Frame.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{AppThemeBinding Light=#A5D6A7, Dark=#2E7D32}" Offset="0.0"/>
                                    <GradientStop Color="{AppThemeBinding Light=#66BB6A, Dark=#1B5E20}" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Frame.Background>

                            <Label Text="🎲"
                                   FontSize="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <!-- Text -->

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="4">

                            <Label Text="Need inspiration?"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}"/>

                            <Label Text="Shake your phone for a surprise healthy meal idea ✨"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   TextColor="{AppThemeBinding Light=#558B2F, Dark=#C8E6C9}"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>

                    </Grid>
                </Frame>

                <!-- Bottom spacing -->
                <BoxView HeightRequest="8" BackgroundColor="Transparent"/>

            </VerticalStackLayout>
		</VerticalStackLayout>
	</ScrollView>

</ContentPage>