<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriLens.Views.ScannerPage"
             Title="Scanner"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Header -->
            <Grid HeightRequest="120"
                  BackgroundColor="#4CAF50">
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="4">
                    <Label Text="Food Scanner 📷"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Label Text="Identify food by photo or barcode"
                           FontSize="13"
                           TextColor="#C8E6C9"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- Tab Switcher -->
                <Frame BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2C2C2C}"
                       CornerRadius="16"
                       Padding="4"
                       BorderColor="Transparent">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                        <Button x:Name="PhotoTabButton"
                                Grid.Column="0"
                                Text="📷 Photo"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="44"
                                FontAttributes="Bold"
                                Clicked="OnPhotoTabClicked"/>
                        <Button x:Name="BarcodeTabButton"
                                Grid.Column="1"
                                Text="🔍 Barcode"
                                BackgroundColor="Transparent"
                                TextColor="Gray"
                                CornerRadius="12"
                                HeightRequest="44"
                                Clicked="OnBarcodeTabClicked"/>
                    </Grid>
                </Frame>

                <!-- Photo Panel -->
                <VerticalStackLayout x:Name="PhotoPanel" Spacing="12">
                    <Frame CornerRadius="20"
                           Padding="0"
                           IsClippedToBounds="True"
                           HeightRequest="250"
                           IsVisible="{Binding Source={x:Reference FoodImage}, Path=IsVisible}"
                           BorderColor="Transparent">
                        <Image x:Name="FoodImage"
                               HeightRequest="250"
                               IsVisible="False"
                               Aspect="AspectFit"
                               HorizontalOptions="Fill"/>
                    </Frame>

                    <!-- Photo Panel - replace the inner Frame content -->
                    <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}"
                           CornerRadius="20"
                           Padding="20"
                           BorderColor="Transparent">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Take a photo or choose from gallery"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   TextColor="Gray"
                                   HorizontalOptions="Center"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Grid.Column="0"
                                        Text="Take Photo"
                                        BackgroundColor="#4CAF50"
                                        TextColor="White"
                                        CornerRadius="14"
                                        HeightRequest="50"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Clicked="OnTakePhotoClicked"/>
                                <Button Grid.Column="1"
                                        Text="Gallery"
                                        BackgroundColor="#2196F3"
                                        TextColor="White"
                                        CornerRadius="14"
                                        HeightRequest="50"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        Clicked="OnPickPhotoClicked"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- Barcode Panel -->
                <VerticalStackLayout x:Name="BarcodePanel"
                                     IsVisible="False"
                                     Spacing="12">
                    <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}"
                           CornerRadius="20"
                           Padding="20"
                           BorderColor="Transparent">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="🔍 Scan or enter barcode"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   TextColor="Gray"
                                   HorizontalOptions="Center"/>
                            <Button Text="📷 Scan Barcode"
                                    BackgroundColor="#2196F3"
                                    TextColor="White"
                                    CornerRadius="14"
                                    HeightRequest="50"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    Clicked="OnScanBarcodeClicked"/>
                            <Frame BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}"
                                   CornerRadius="12"
                                   Padding="4"
                                   BorderColor="Transparent">
                                <Entry x:Name="ManualBarcodeEntry"
                                       Placeholder="Or enter barcode manually"
                                       Keyboard="Numeric"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       BackgroundColor="Transparent"
                                       Margin="8,0"/>
                            </Frame>
                            <Button Text="🔎 Search"
                                    BackgroundColor="#2196F3"
                                    TextColor="White"
                                    CornerRadius="14"
                                    HeightRequest="46"
                                    Clicked="OnManualSearchClicked"/>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- Loading -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="#4CAF50"
                                   HorizontalOptions="Center"/>

                <!-- Result Area -->
                <Frame x:Name="ResultFrame"
                       IsVisible="False"
                       CornerRadius="20"
                       Padding="20"
                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}"
                       BorderColor="Transparent">
                    <VerticalStackLayout Spacing="14">

                        <Label x:Name="FoodNameLabel"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>

                        <!-- Allergen Warning -->
                        <Frame x:Name="AllergenFrame"
                               IsVisible="False"
                               BackgroundColor="#FFEBEE"
                               CornerRadius="12"
                               Padding="12"
                               BorderColor="#FFCDD2">
                            <Label x:Name="AllergenLabel"
                                   TextColor="#D32F2F"
                                   FontAttributes="Bold"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </Frame>

                        <!-- Nutrition Grid -->
                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="10"
                              ColumnSpacing="10">

                            <Frame Grid.Row="0" Grid.Column="0"
                                   BackgroundColor="#E8F5E9"
                                   CornerRadius="14"
                                   Padding="14"
                                   BorderColor="Transparent">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="🔥 Calories"
                                           FontSize="12"
                                           TextColor="Gray"/>
                                    <Label x:Name="CaloriesLabel"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#4CAF50"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="0" Grid.Column="1"
                                   BackgroundColor="#E3F2FD"
                                   CornerRadius="14"
                                   Padding="14"
                                   BorderColor="Transparent">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="💪 Protein"
                                           FontSize="12"
                                           TextColor="Gray"/>
                                    <Label x:Name="ProteinLabel"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#2196F3"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="1" Grid.Column="0"
                                   BackgroundColor="#FFF3E0"
                                   CornerRadius="14"
                                   Padding="14"
                                   BorderColor="Transparent">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="🥑 Fat"
                                           FontSize="12"
                                           TextColor="Gray"/>
                                    <Label x:Name="FatLabel"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#FF9800"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame Grid.Row="1" Grid.Column="1"
                                   BackgroundColor="#FCE4EC"
                                   CornerRadius="14"
                                   Padding="14"
                                   BorderColor="Transparent">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="🍬 Sugar"
                                           FontSize="12"
                                           TextColor="Gray"/>
                                    <Label x:Name="SugarLabel"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#E91E63"/>
                                </VerticalStackLayout>
                            </Frame>

                        </Grid>

                        <!-- TTS Button -->
                        <Button Text="🔊 Read Nutrition Aloud"
                                BackgroundColor="#FF9800"
                                TextColor="White"
                                CornerRadius="14"
                                HeightRequest="48"
                                FontAttributes="Bold"
                                Clicked="OnReadAloudClicked"/>

                        <!-- Save Buttons -->
                        <Label Text="Save to:"
                               FontSize="13"
                               TextColor="Gray"
                               HorizontalOptions="Center"/>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Text="🌅"
                                    BackgroundColor="#FFF9C4"
                                    TextColor="#F57F17"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    FontSize="22"
                                    Clicked="OnSaveBreakfastClicked"/>
                            <Button Grid.Column="1"
                                    Text="☀️"
                                    BackgroundColor="#FFE0B2"
                                    TextColor="#E65100"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    FontSize="22"
                                    Clicked="OnSaveLunchClicked"/>
                            <Button Grid.Column="2"
                                    Text="🌙"
                                    BackgroundColor="#E8EAF6"
                                    TextColor="#3949AB"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    FontSize="22"
                                    Clicked="OnSaveDinnerClicked"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="0">
                            <Label Grid.Column="0" Text="Breakfast"
                                   FontSize="11" TextColor="Gray"
                                   HorizontalOptions="Center"/>
                            <Label Grid.Column="1" Text="Lunch"
                                   FontSize="11" TextColor="Gray"
                                   HorizontalOptions="Center"/>
                            <Label Grid.Column="2" Text="Dinner"
                                   FontSize="11" TextColor="Gray"
                                   HorizontalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>