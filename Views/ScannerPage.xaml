<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriLens.Views.ScannerPage"
             Title="Scanner">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Food Scanner 📷"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <!-- Tab Switcher -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                <Button x:Name="PhotoTabButton"
                        Grid.Column="0"
                        Text="📷 Photo"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="10"
                        Clicked="OnPhotoTabClicked"/>
                <Button x:Name="BarcodeTabButton"
                        Grid.Column="1"
                        Text="🔍 Barcode"
                        BackgroundColor="#E0E0E0"
                        TextColor="Black"
                        CornerRadius="10"
                        Clicked="OnBarcodeTabClicked"/>
            </Grid>

            <!-- Photo Panel -->
            <VerticalStackLayout x:Name="PhotoPanel" Spacing="10">
                <Label Text="Take a photo of your food to identify it"
                       FontSize="{DynamicResource GlobalFontSize}"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>
                <Button Text="📷 Take Photo"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="10"
                        FontSize="18"
                        Clicked="OnTakePhotoClicked"/>
                <Image x:Name="FoodImage"
                       HeightRequest="200"
                       IsVisible="False"
                       Aspect="AspectFill"/>
            </VerticalStackLayout>

            <!-- Barcode Panel -->
            <VerticalStackLayout x:Name="BarcodePanel"
                                 IsVisible="False"
                                 Spacing="10">
                <Label Text="Scan a food barcode"
                       FontSize="{DynamicResource GlobalFontSize}"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>
                <Button Text="🔍 Scan Barcode"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        CornerRadius="10"
                        FontSize="18"
                        Clicked="OnScanBarcodeClicked"/>
                <Entry x:Name="ManualBarcodeEntry"
                       Placeholder="Or enter barcode manually"
                       Keyboard="Numeric"
                       FontSize="{DynamicResource GlobalFontSize}"/>
                <Button Text="🔎 Search"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        CornerRadius="10"
                        Clicked="OnManualSearchClicked"/>
            </VerticalStackLayout>

            <!-- Loading -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#4CAF50"
                               HorizontalOptions="Center"/>

            <!-- Result Area -->
            <Frame x:Name="ResultFrame"
                   IsVisible="False"
                   CornerRadius="15"
                   Padding="20">
                <VerticalStackLayout Spacing="10">

                    <Label x:Name="FoodNameLabel"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>

                    <!-- Allergen Warning -->
                    <Frame x:Name="AllergenFrame"
                           IsVisible="False"
                           BackgroundColor="#FFEBEE"
                           CornerRadius="10"
                           Padding="10">
                        <Label x:Name="AllergenLabel"
                               TextColor="Red"
                               FontAttributes="Bold"
                               FontSize="{DynamicResource GlobalFontSize}"
                               HorizontalOptions="Center"/>
                    </Frame>

                    <!-- Nutrition Grid -->
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="8"
                          ColumnSpacing="8">

                        <Frame Grid.Row="0" Grid.Column="0"
                               BackgroundColor="#E8F5E9"
                               CornerRadius="10" Padding="10">
                            <VerticalStackLayout>
                                <Label Text="Calories"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       TextColor="Gray"/>
                                <Label x:Name="CaloriesLabel"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#4CAF50"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Row="0" Grid.Column="1"
                               BackgroundColor="#E3F2FD"
                               CornerRadius="10" Padding="10">
                            <VerticalStackLayout>
                                <Label Text="Protein"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       TextColor="Gray"/>
                                <Label x:Name="ProteinLabel"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#2196F3"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Row="1" Grid.Column="0"
                               BackgroundColor="#FFF3E0"
                               CornerRadius="10" Padding="10">
                            <VerticalStackLayout>
                                <Label Text="Fat"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       TextColor="Gray"/>
                                <Label x:Name="FatLabel"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#FF9800"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Row="1" Grid.Column="1"
                               BackgroundColor="#FCE4EC"
                               CornerRadius="10" Padding="10">
                            <VerticalStackLayout>
                                <Label Text="Sugar"
                                       FontSize="{DynamicResource GlobalFontSize}"
                                       TextColor="Gray"/>
                                <Label x:Name="SugarLabel"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#E91E63"/>
                            </VerticalStackLayout>
                        </Frame>

                    </Grid>

                    <!-- Action Buttons -->
                    <Button Text="🔊 Read Aloud"
                            BackgroundColor="#FF9800"
                            TextColor="White"
                            CornerRadius="10"
                            Clicked="OnReadAloudClicked"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="🌅 Breakfast"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="10"
                                Clicked="OnSaveBreakfastClicked"/>
                        <Button Grid.Column="1"
                                Text="☀️ Lunch"
                                BackgroundColor="#2196F3"
                                TextColor="White"
                                CornerRadius="10"
                                Clicked="OnSaveLunchClicked"/>
                    </Grid>

                    <Button Text="🌙 Save as Dinner"
                            BackgroundColor="#9C27B0"
                            TextColor="White"
                            CornerRadius="10"
                            Clicked="OnSaveDinnerClicked"/>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>