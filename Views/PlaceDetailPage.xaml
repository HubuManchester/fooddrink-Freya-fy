<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriLens.Views.PlaceDetailPage"
             Title="Restaurant Detail"
             BackgroundColor="{AppThemeBinding Light=#F0F4F8, Dark=#0F0F1A}">

	<ScrollView>
		<VerticalStackLayout Spacing="0">

			<!-- Hero Header -->
			<Grid x:Name="HeroGrid" HeightRequest="180" BackgroundColor="#4CAF50">
				<VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="8">
					<Frame BackgroundColor="#FFFFFF33"
                           CornerRadius="40"
                           WidthRequest="80"
                           HeightRequest="80"
                           Padding="0"
                           BorderColor="Transparent"
                           HorizontalOptions="Center">
						<Label Text="🍽️"
                               FontSize="40"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
					</Frame>
					<Label x:Name="NameLabel"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="20,0"/>
				</VerticalStackLayout>
			</Grid>

			<!-- Type + Distance + Rating badges -->
			<Frame Margin="16,-20,16,0"
                   CornerRadius="20"
                   Padding="16"
                   HasShadow="True"
                   BorderColor="Transparent"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}">
				<HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
					<Frame x:Name="TypeBadge"
                           BackgroundColor="#E8F5E9"
                           CornerRadius="12"
                           Padding="12,6"
                           BorderColor="Transparent">
						<Label x:Name="TypeLabel"
                               FontSize="{DynamicResource GlobalFontSize}"
                               FontAttributes="Bold"
                               TextColor="#4CAF50"/>
					</Frame>
					<Frame BackgroundColor="#E3F2FD"
                           CornerRadius="12"
                           Padding="12,6"
                           BorderColor="Transparent">
						<Label x:Name="DistanceLabel"
                               FontSize="{DynamicResource GlobalFontSize}"
                               FontAttributes="Bold"
                               TextColor="#2196F3"/>
					</Frame>
					<Frame x:Name="RatingBadge"
                           BackgroundColor="#FFF3E0"
                           CornerRadius="12"
                           Padding="12,6"
                           BorderColor="Transparent">
						<HorizontalStackLayout Spacing="4">
							<Label Text="⭐" FontSize="13" VerticalOptions="Center"/>
							<Label x:Name="RatingLabel"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   FontAttributes="Bold"
                                   TextColor="#FF9800"
                                   VerticalOptions="Center"/>
						</HorizontalStackLayout>
					</Frame>
				</HorizontalStackLayout>
			</Frame>

			<!-- Info Card -->
			<Frame Margin="16,14,16,0"
                   CornerRadius="20"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="Transparent"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}">
				<VerticalStackLayout Spacing="16">

					<!-- Address -->
					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
						<Frame Grid.Column="0"
                               BackgroundColor="#E8F5E9"
                               CornerRadius="12"
                               WidthRequest="44" HeightRequest="44"
                               Padding="0" BorderColor="Transparent">
							<Label Text="📍" FontSize="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
						</Frame>
						<VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="2">
							<Label Text="Address"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   TextColor="Gray" FontAttributes="Bold"/>
							<Label x:Name="AddressLabel"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   LineBreakMode="WordWrap"/>
						</VerticalStackLayout>
					</Grid>

					<BoxView HeightRequest="1" BackgroundColor="#F0F0F0"/>

					<!-- Phone -->
					<Grid x:Name="PhoneRow"
                          ColumnDefinitions="Auto,*" ColumnSpacing="14">
						<Frame Grid.Column="0"
                               BackgroundColor="#E3F2FD"
                               CornerRadius="12"
                               WidthRequest="44" HeightRequest="44"
                               Padding="0" BorderColor="Transparent">
							<Label Text="📞" FontSize="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
						</Frame>
						<VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="2">
							<Label Text="Phone"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   TextColor="Gray" FontAttributes="Bold"/>
							<Label x:Name="PhoneLabel"
                                   FontSize="{DynamicResource GlobalFontSize}"/>
						</VerticalStackLayout>
					</Grid>

					<BoxView x:Name="HoursDivider"
                             HeightRequest="1" BackgroundColor="#F0F0F0"/>

					<!-- Hours -->
					<Grid x:Name="HoursRow"
                          ColumnDefinitions="Auto,*" ColumnSpacing="14">
						<Frame Grid.Column="0"
                               BackgroundColor="#FFF3E0"
                               CornerRadius="12"
                               WidthRequest="44" HeightRequest="44"
                               Padding="0" BorderColor="Transparent">
							<Label Text="🕐" FontSize="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
						</Frame>
						<VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="2">
							<Label Text="Hours"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   TextColor="Gray" FontAttributes="Bold"/>
							<Label x:Name="HoursLabel"
                                   FontSize="{DynamicResource GlobalFontSize}"
                                   LineBreakMode="WordWrap"/>
						</VerticalStackLayout>
					</Grid>

				</VerticalStackLayout>
			</Frame>

			<!-- Stars Card -->
			<Frame x:Name="StarsCard"
                   Margin="16,14,16,0"
                   CornerRadius="20"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="Transparent"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}">
				<VerticalStackLayout Spacing="8" HorizontalOptions="Center">
					<Label Text="Rating"
                           FontSize="{DynamicResource GlobalFontSize}"
                           TextColor="Gray" FontAttributes="Bold"
                           HorizontalOptions="Center"/>
					<Label x:Name="StarsLabel"
                           FontSize="28"
                           HorizontalOptions="Center"/>
					<Label x:Name="RatingValueLabel"
                           FontSize="{DynamicResource GlobalFontSize}"
                           FontAttributes="Bold"
                           TextColor="#FF9800"
                           HorizontalOptions="Center"/>
				</VerticalStackLayout>
			</Frame>

			<!-- TTS Card -->
			<Frame Margin="16,14,16,0"
                   CornerRadius="20"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="Transparent"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}">
				<VerticalStackLayout Spacing="12">
					<HorizontalStackLayout Spacing="8">
						<Label Text="🔊" FontSize="18" VerticalOptions="Center"/>
						<Label Text="Read Aloud"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="Gray" VerticalOptions="Center"/>
					</HorizontalStackLayout>
					<Label x:Name="TtsPreviewLabel"
                           FontSize="13"
                           TextColor="Gray"
                           LineBreakMode="WordWrap"/>
					<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
						<Button Grid.Column="0"
                                x:Name="SpeakButton"
                                Text="🔊 Read Aloud"
                                BackgroundColor="#FF9800"
                                TextColor="White"
                                CornerRadius="14"
                                HeightRequest="48"
                                FontSize="{DynamicResource GlobalFontSize}"
                                FontAttributes="Bold"
                                Clicked="OnSpeakClicked"/>
						<Button Grid.Column="1"
                                x:Name="StopButton"
                                Text="⏹ Stop"
                                BackgroundColor="#9E9E9E"
                                TextColor="White"
                                CornerRadius="14"
                                HeightRequest="48"
                                FontSize="{DynamicResource GlobalFontSize}"
                                FontAttributes="Bold"
                                IsEnabled="False"
                                Clicked="OnStopClicked"/>
					</Grid>
				</VerticalStackLayout>
			</Frame>

			<!-- Close Button -->
			<Button Text="Close"
                    Margin="16,14,16,28"
                    BackgroundColor="#EEEEEE"
                    TextColor="#555555"
                    CornerRadius="16"
                    HeightRequest="52"
                    FontSize="{DynamicResource GlobalFontSize}"
                    FontAttributes="Bold"
                    Clicked="OnCloseClicked"/>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>