<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriLens.Views.MealSuggestionPage"
             BackgroundColor="#80000000"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Dimmed background tap to close -->
        <BoxView BackgroundColor="#80000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackgroundTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Card -->
        <Frame VerticalOptions="Center"
               HorizontalOptions="Center"
               WidthRequest="320"
               CornerRadius="28"
               Padding="0"
               HasShadow="True"
               BorderColor="Transparent"
               BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}"
               Margin="24,0">
            <VerticalStackLayout Spacing="0">

                <!-- Header -->
                <Grid x:Name="HeaderGrid"
                      HeightRequest="130"
                      BackgroundColor="#4CAF50">
                    <VerticalStackLayout VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="6">
                        <Label x:Name="EmojiLabel"
                               FontSize="44"
                               HorizontalOptions="Center"/>
                        <Label Text="Meal Suggestion"
                               FontSize="{DynamicResource GlobalFontSize}"
                               TextColor="#C8E6C9"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               CharacterSpacing="1.5"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Content -->
                <VerticalStackLayout Padding="24,20" Spacing="16">

                    <!-- Meal Name -->
                    <Label x:Name="MealNameLabel"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>

                    <!-- Calorie Badge -->
                    <Frame HorizontalOptions="Center"
                           BackgroundColor="#E8F5E9"
                           CornerRadius="20"
                           Padding="16,8"
                           BorderColor="Transparent">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="🔥"
                                   FontSize="16"
                                   VerticalOptions="Center"/>
                            <Label x:Name="CalorieLabel"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#4CAF50"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Frame>

                    <!-- Divider -->
                    <BoxView HeightRequest="1"
                             BackgroundColor="#F0F0F0"
                             Margin="0,4"/>

                    <!-- Tip -->
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="8">
                        <Label Text="💡"
                               FontSize="14"
                               VerticalOptions="Center"/>
                        <Label Text="Shake again for another suggestion"
                               FontSize="13"
                               TextColor="Gray"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <Button Grid.Column="0"
                                Text="Shuffle 🎲"
                                BackgroundColor="#F0F0F0"
                                TextColor="#555555"
                                CornerRadius="14"
                                HeightRequest="48"
                                FontSize="14"
                                FontAttributes="Bold"
                                Clicked="OnShuffleClicked"/>
                        <Button Grid.Column="1"
                                Text="Got it!"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="14"
                                HeightRequest="48"
                                FontSize="{DynamicResource GlobalFontSize}"
                                FontAttributes="Bold"
                                Clicked="OnGotItClicked"/>
                    </Grid>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </Frame>

    </Grid>
</ContentPage>